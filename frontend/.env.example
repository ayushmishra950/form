# Base URL of the Express API.
#
# Single-service deploy (backend serves the SPA): use a relative path
#   VITE_API_URL=/api
# Separate frontend and backend hosts: use the full API origin
#   VITE_API_URL=https://your-api.onrender.com/api
# VITE_API_URL=http://localhost:4010/api
VITE_API_URL=https://form-z06g.onrender.com/api
