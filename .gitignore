node_modules/

# Secrets — only the .example files are committed.
backend/.env
frontend/.env
.env.local

# Compiled backend output — rebuilt on the host by `npm run build`.
backend/dist/

# Vite's intermediate output. The copy that ships lives in backend/build/,
# which IS committed: the server serves it, and Render never rebuilds it.
frontend/dist/

# Logs / OS noise
*.log
.DS_Store
