{
  "compilerOptions": {
    // File Layout - अब ये चालू हैं और सही फ़ोल्डर बनाएंगे
    "rootDir": "./",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Other Outputs - "noEmit" को हटा दिया गया है ताकि JS फ़ाइलें जेनरेट हों
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions":true,
    "noEmit": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },

  "include": ["**/*.ts"],
  "exclude": [
    "node_modules", 
    "dist", 
    "scripts"
  ]
}
