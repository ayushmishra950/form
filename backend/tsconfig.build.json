{
  // Production build config.
  //
  // The base tsconfig is a *type-checking* config: it sets `noEmit`, so
  // `tsc` there produces no JavaScript at all. This one turns emit on and
  // writes plain ESM into dist/, which is what `npm start` runs — so the
  // deployed server needs no TypeScript loader at runtime.
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",

    // The source imports with explicit ".ts" specifiers (./app.ts). This
    // rewrites them to "./app.js" in the output so Node can resolve them.
    "rewriteRelativeImportExtensions": true,

    // Type declarations are only useful for published libraries.
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },

  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    // Frontend build output that this server serves statically.
    "build",
    // Local-only helper: it imports mongodb-memory-server, a devDependency
    // that is not installed on a production host.
    "scripts/dev-memory.ts"
  ]
}
