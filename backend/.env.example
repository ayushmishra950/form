# Copy to .env and fill in real values.
NODE_ENV=development
PORT=4010

# Local mongod, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/main-form

# Browser origins allowed to send auth cookies (comma separated).
CORS_ORIGINS=http://localhost:5173
# Used to build the public share link returned after publishing a form.
APP_ORIGIN=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-me-with-64-hex-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_PEPPER=replace-me-with-64-hex-characters
REFRESH_TOKEN_TTL_DAYS=7
